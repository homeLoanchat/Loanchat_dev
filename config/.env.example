# FastAPI/LangChain 공통 설정 샘플
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000

# API 및 CORS
LOANBOT_ALLOWED_ORIGINS=*
ADMIN_ACCESS_TOKEN=changeme

# OpenAI 또는 호환 LLM 공급자 키
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=changeme

# 벡터스토어 설정
VECTOR_DB_PATH=./data/embeddings/chroma
VECTOR_DB_COLLECTION=loanbot_docs

# 외부 검색/웹크롤링 토큰 (필요 시)
SEARCH_API_KEY=
UPSTAGE_API_KEY=

# 데이터 수집/공공데이터
DATA_GO_KR_KEY=

# 로깅/모니터링 옵션
LOG_LEVEL=INFO
LANGSMITH_API_KEY=
