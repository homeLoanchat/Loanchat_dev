# 기본 실행 설정
ENV=local
PORT=8000
LOG_LEVEL=INFO
LOANBOT_ALLOWED_ORIGINS=http://localhost:5173
VECTORSTORE_PATH=./data/vectorstore
METRICS_WINDOW=1000

# 관리자 API 토큰 (임의 값으로 교체)
ADMIN_SECRET=change-me-admin-token

# 외부 데이터/검색 키
DATA_GO_KR_KEY=change-me-data-go-kr-key

# Upstage LLM 설정
UPSTAGE_API_KEY=change-me-upstage-key
UPSTAGE_CHAT_MODEL=solar-pro2

# SerpAPI 웹 검색 키
SERPAPI_KEY=change-me-serpapi-key
