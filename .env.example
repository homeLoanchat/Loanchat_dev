# FastAPI 기본 설정
ENV=local
PORT=8000
LOG_LEVEL=INFO
LOANBOT_ALLOWED_ORIGINS=http://localhost:5173

# 스토리지/검색 설정
VECTORSTORE_PATH=./data/vectorstore
WEBSEARCH_API_KEY=your-web-search-key

# 관리자 토큰 (반드시 비밀로 관리)
ADMIN_SECRET=replace-with-strong-secret

# 메트릭 히스토리 길이
METRICS_WINDOW=1000

# 공공데이터 포털 API 키 (scripts/ingest.py 등에서 사용)
DATA_GO_KR_KEY=

# Upstage LLM 키 (Upstage API를 사용할 경우 설정)
UPSTAGE_API_KEY=
